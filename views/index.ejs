<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <title>Floral Design</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <link href="/css/styles.css" rel="stylesheet" type="text/css" />
  </head>
  <body>
    <div id="container">
      <div id="topLine"></div>
      <div id="logoPan">
        <img src="/images/logo.gif" width="192" height="92" alt="" id="logo" />
        <img
          src="/images/slogan.gif"
          width="297"
          height="46"
          alt=""
          id="slogan"
        />
      </div>
      <div id="menuPan">
        <ul class="menu">
          <li class="btn_1"><a href="#">home page</a></li>
          <li class="line"></li>
          <li class="btn_2"><a href="#">about us</a></li>
          <li class="line"></li>
          <li class="btn_3"><a href="#">bouquets</a></li>
          <li class="line"></li>
          <li class="btn_4"><a href="#">specials</a></li>
          <li class="line"></li>
          <li class="btn_5"><a href="#">contacts</a></li>
        </ul>
      </div>
      <div id="header">
        <img
          src="/images/slogan2.gif"
          width="192"
          height="70"
          alt=""
          id="slogan2"
        />
      </div>
      <div id="content">
        <div id="leftPan">
          <div id="welcome">
            <h2></h2>
            <img src="/images/img_welcome.jpg" width="172" height="56" alt="" />
            <p class="headline">
              Fresh floral arrangements crafted to brighten every special
              moment.
            </p>
            <p>
              Discover elegant bouquets, seasonal flowers, and thoughtful gifts
              designed for birthdays, weddings, anniversaries, and everyday
              surprises. Our team carefully selects every bloom to ensure
              beauty, freshness, and lasting charm.
            </p>
          </div>
        </div>
        <div id="rightPan">
          <div id="featured">
            <h2></h2>
            <p class="headline">
              Explore our featured collection of hand-tied bouquets and floral
              designs for every occasion.
            </p>
            <div class="featItem" id="i01">
              <img src="/images/img_prod.jpg" width="116" height="125" alt="" />
              <p>
                <span class="headline2">Romantic Rose Bouquet</span><br />
                <a href="#">View arrangement details</a><br />
                A timeless selection of fresh roses styled with soft greenery.
              </p>
            </div>
            <div class="featItem" id="i02">
              <img
                src="/images/img_prod-13.jpg"
                width="116"
                height="125"
                alt=""
              />
              <p>
                <span class="headline2">Spring Garden Basket</span><br />
                <a href="#">Browse this bouquet</a><br />
                A cheerful mix of colorful blooms arranged in a charming basket.
              </p>
            </div>
            <div class="featItem" id="i03">
              <img
                src="/images/img_prod-14.jpg"
                width="116"
                height="125"
                alt=""
              />
              <p>
                <span class="headline2">Elegant Wedding Flowers</span><br />
                <a href="#">See the full collection</a><br />
                Sophisticated floral styling tailored for ceremonies and
                receptions.
              </p>
            </div>
            <div class="clear"></div>
          </div>
        </div>
        <div id="services">
          <h2>Featured Services</h2>
          <div class="service-grid">
            <div class="service-card">
              <h3>2-Hour Delivery</h3>
              <p>On-time city delivery for urgent flower orders.</p>
            </div>
            <div class="service-card">
              <h3>Custom Designs</h3>
              <p>
                Choose flower colors, bouquet styles, and cards for each event.
              </p>
            </div>
            <div class="service-card">
              <h3>Fresh Flowers Daily</h3>
              <p>
                We select fresh blooms daily and protect them before delivery.
              </p>
            </div>
          </div>
        </div>
        <div id="aboutShop">
          <h2>About the Shop</h2>
          <p>
            Flower Corner embraces an elegant, gentle, and modern style.
            Customers can choose from ready-made designs or request custom
            arrangements based on their preferred colors, flower types, and
            budget.
          </p>
          <p>
            We provide floral decoration for small events, corporate gifts, and
            personalized bouquets for every occasion.
          </p>
        </div>
        <div id="contactForm">
          <h2>Liên hệ đặt hoa</h2>
          <input type="text" placeholder="Cao Đăng Quyền" />
          <input type="text" placeholder="Số điện thoại: 0372382499" />
          <textarea placeholder="Nội dung yêu cầu"></textarea>
          <button>Gửi yêu cầu</button>
        </div>
        <div class="clear" id="end"></div>
      </div>
    </div>
    <div id="footer">
      <p>
        <a href="#">HOME PAGE</a> | <a href="#">ABOUT US</a> |
        <a href="#">BOUTQUETS</a> | <a href="#">SPECIALS</a> |
        <a href="#">NEWS</a> | <a href="#">CONTACTS</a><br />
        Copyright &copy; Your Company Name | Design by
        <a href="http://freshtemplates.com/">Website Templates</a>
      </p>
    </div>
    <div align="center">
      This template was downloaded from
      <a href="http://all-free-download.com/free-website-templates/"
        >free website templates</a
      >
    </div>
  </body>
</html>
